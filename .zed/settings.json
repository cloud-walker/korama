{
	"languages": {
		"TypeScript": {
			"formatter": {
				"external": {
					"command": "pnpm",
					"arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"format_on_save": "on",
			"language_servers": ["oxlint", "..."]
		},
		"TSX": {
			"formatter": {
				"external": {
					"command": "pnpm",
					"arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"format_on_save": "on",
			"language_servers": ["oxlint", "..."]
		},
		"JavaScript": {
			"formatter": {
				"external": {
					"command": "pnpm",
					"arguments": ["exec", "oxfmt", "--stdin-filepath", "{buffer_path}"]
				}
			},
			"format_on_save": "on",
			"language_servers": ["oxlint", "..."]
		}
	}
}
