{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "typescript",
    "react",
    "unicorn",
    "oxc"
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "**/styled-system/**",
    "**/.react-router/**",
    "**/dist/**"
  ],
  "rules": {
    "react/react-in-jsx-scope": "off"
  }
}
